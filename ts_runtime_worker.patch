+import { dirname } from 'node:path'
+import process from 'node:process'
+import readline from 'node:readline/promises'
+import { fileURLToPath } from 'node:url'
+import type { CommandRunResult, HandshakeResult, WorkerStreamEvent } from './protocol.js'
+import { PythonWorkerClient } from './workerClient.js'
+
+type CliOptions = {
+  execCommands: string[]
+  showBanner: boolean
+  showHelp: boolean
+  showVersion: boolean
+}
+
+type CommandOutcome = {
+  continueRunning: boolean
+  exitCode: number
+}
+
+type RuntimeState = {
+  handshake: HandshakeResult
+}
+
+const RUNTIME_VERSION = '0.1.0'
+const BUILTIN_COMMANDS = new Set(['getNews', 'predict_btc', 'Runway', 'cockpit'])
+
+function getProjectRoot(): string {
+  const runtimeFile = fileURLToPath(import.meta.url)
+  return dirname(dirname(dirname(runtimeFile)))
+}
+
+function parseArgs(argv: string[]): CliOptions {
+  const options: CliOptions = {
+    execCommands: [],
+    showBanner: true,
+    showHelp: false,
+    showVersion: false,
+  }
+
+  for (let index = 0; index < argv.length; index += 1) {
+    const value = argv[index]
+
+    if (value === '--no-banner') {
+      options.showBanner = false
+      continue
+    }
+
+    if (value === '--help' || value === '-h') {
+      options.showHelp = true
+      continue
+    }
+
+    if (value === '--version') {
+      options.showVersion = true
+      continue
+    }
+
+    if (value === '--exec') {
+      const nextValue = argv[index + 1]
+      if (!nextValue) {
+        throw new Error('--exec 需要一个命令字符串')
+      }
+      options.execCommands.push(nextValue)
+      index += 1
+      continue
+    }
+
+    throw new Error(`未知参数: ${value}`)
+  }
+
+  return options
+}
+
+function splitCommandLine(input: string): string[] {
+  const tokens: string[] = []
+  let current = ''
+  let quote: '"' | "'" | null = null
+  let escaped = false
+
+  for (const char of input) {
+    if (escaped) {
+      current += char
+      escaped = false
+      continue
+    }
+
+    if (char === '\\') {
+      escaped = true
+      continue
+    }
+
+    if (quote) {
+      if (char === quote) {
+        quote = null
+      } else {
+        current += char
+      }
+      continue
+    }
+
+    if (char === '"' || char === "'") {
+      quote = char
+      continue
+    }
+
+    if (/\s/.test(char)) {
+      if (current) {
+        tokens.push(current)
+        current = ''
+      }
+      continue
+    }
+
+    current += char
+  }
+
+  if (escaped) {
+    current += '\\'
+  }
+
+  if (quote) {
+    throw new Error('命令存在未闭合的引号')
+  }
+
+  if (current) {
+    tokens.push(current)
+  }
+
+  return tokens
+}
+
+function formatRunwayProjects(projects: HandshakeResult['runwayProjects']): string {
+  if (projects.length === 0) {
+    return 'None'
+  }
+
+  return projects.map(project => project.name).join(', ')
+}
+
+function printHelp(handshake?: HandshakeResult): void {
+  const lines = [
+    'Shook TS Runtime',
+    '',
+    '内置命令：',
+    '  getNews [--dry-run] [--date YYYY-MM-DD]   生成日报',
+    '  predict_btc [--output-dir PATH]           生成 BTC 预测看板',
+    '  Runway add --name NAME --path PATH        添加 Runway 项目',
+    '  Runway delete --name NAME                 删除 Runway 项目',
+    '  Runway list                               列出所有项目',
+    '  cockpit                                   打开 Prompt 优化工作台',
+    '  help | ?                                  显示帮助',
+    '  exit | quit | q                           退出运行时',
+    '',
+    '其他输入会通过 Python worker 转发到 zsh 执行。',
+    `旧版 Python UI：${handshake?.legacyUiCommand ?? 'python scripts/shook.py'} 或 ./shook --legacy-ui`,
+  ]
+
+  if (handshake) {
+    lines.push(`当前 Runway 项目：${formatRunwayProjects(handshake.runwayProjects)}`)
+  }
+
+  console.log(lines.join('\n'))
+}
+
+function renderBanner(handshake: HandshakeResult): void {
+  const lines = [
+    `Shook TS Runtime v${RUNTIME_VERSION}`,
+    `项目根目录: ${handshake.projectRoot}`,
+    `Runway: ${formatRunwayProjects(handshake.runwayProjects)}`,
+    `旧版 Python UI: ${handshake.legacyUiCommand} 或 ./shook --legacy-ui`,
+    '输入 help 查看命令，输入 exit 退出。',
+    '',
+  ]
+
+  console.log(lines.join('\n'))
+}
+
+function writeCommandStream(event: WorkerStreamEvent): void {
+  const writer = event.stream === 'stderr' ? process.stderr : process.stdout
+  writer.write(`${event.line}\n`)
+}
+
+async function runCommand(
+  line: string,
+  client: PythonWorkerClient,
+  state: RuntimeState,
+): Promise<CommandOutcome> {
+  const trimmed = line.trim()
+  if (!trimmed) {
+    return { continueRunning: true, exitCode: 0 }
+  }
+
+  let tokens: string[]
+
+  try {
+    tokens = splitCommandLine(trimmed)
+  } catch (error) {
+    console.error(`[shook] ${(error as Error).message}`)
+    return { continueRunning: true, exitCode: 1 }
+  }
+
+  const [command, ...args] = tokens
+
+  if (!command) {
+    return { continueRunning: true, exitCode: 0 }
+  }
+
+  if (command === 'help' || command === '?') {
+    printHelp(state.handshake)
+    return { continueRunning: true, exitCode: 0 }
+  }
+
+  if (command === 'exit' || command === 'quit' || command === 'q') {
+    return { continueRunning: false, exitCode: 0 }
+  }
+
+  try {
+    if (BUILTIN_COMMANDS.has(command)) {
+      const result = await client.request<CommandRunResult, { command: string; args: string[] }>(
+        'run_builtin',
+        { command, args },
+        writeCommandStream,
+      )
+
+      if (result.runwayProjects) {
+        state.handshake = {
+          ...state.handshake,
+          runwayProjects: result.runwayProjects,
+        }
+      }
+
+      if (result.exitCode !== 0) {
+        console.error(`[shook] 命令退出码: ${result.exitCode}`)
+      }
+
+      return { continueRunning: true, exitCode: result.exitCode }
+    }
+
+    const result = await client.request<CommandRunResult, { commandLine: string }>(
+      'run_shell',
+      { commandLine: trimmed },
+      writeCommandStream,
+    )
+
+    if (result.exitCode !== 0) {
+      console.error(`[shook] 命令退出码: ${result.exitCode}`)
+    }
+
+    return { continueRunning: true, exitCode: result.exitCode }
+  } catch (error) {
+    console.error(`[shook] ${(error as Error).message}`)
+    return { continueRunning: true, exitCode: 1 }
+  }
+}
+
+async function runExecCommands(
+  commands: string[],
+  client: PythonWorkerClient,
+  state: RuntimeState,
+): Promise<number> {
+  let lastExitCode = 0
+
+  for (const command of commands) {
+    const outcome = await runCommand(command, client, state)
+    lastExitCode = outcome.exitCode
+    if (!outcome.continueRunning) {
+      return lastExitCode
+    }
+  }
+
+  return lastExitCode
+}
+
+async function readCommandsFromStdin(): Promise<string[]> {
+  const chunks: string[] = []
+
+  for await (const chunk of process.stdin) {
+    chunks.push(String(chunk))
+  }
+
+  return chunks
+    .join('')
+    .split(/\r?\n/)
+    .map(line => line.trim())
+    .filter(Boolean)
+}
+
+async function runInteractiveSession(
+  client: PythonWorkerClient,
+  state: RuntimeState,
+): Promise<number> {
+  const rl = readline.createInterface({
+    input: process.stdin,
+    output: process.stdout,
+    terminal: true,
+  })
+
+  let lastExitCode = 0
+
+  try {
+    while (true) {
+      const line = await rl.question('shook> ')
+      const outcome = await runCommand(line, client, state)
+      lastExitCode = outcome.exitCode
+      if (!outcome.continueRunning) {
+        break
+      }
+    }
+  } finally {
+    rl.close()
+  }
+
+  return lastExitCode
+}
+
+async function main(): Promise<number> {
+  const options = parseArgs(process.argv.slice(2))
+
+  if (options.showVersion) {
+    console.log(`Shook TS Runtime v${RUNTIME_VERSION}`)
+    return 0
+  }
+
+  const projectRoot = getProjectRoot()
+  const client = new PythonWorkerClient(projectRoot)
+
+  try {
+    const handshake = await client.request<HandshakeResult, Record<string, never>>('handshake', {})
+    const state: RuntimeState = { handshake }
+
+    if (options.showHelp) {
+      printHelp(handshake)
+      return 0
+    }
+
+    if (options.showBanner) {
+      renderBanner(handshake)
+    }
+
+    if (options.execCommands.length > 0) {
+      return await runExecCommands(options.execCommands, client, state)
+    }
+
+    if (!process.stdin.isTTY) {
+      const commands = await readCommandsFromStdin()
+      return await runExecCommands(commands, client, state)
+    }
+
+    return await runInteractiveSession(client, state)
+  } finally {
+    await client.close()
+  }
+}
+
+void main().then(
+  code => {
+    process.exitCode = code
+  },
+  error => {
+    console.error(`[shook] ${(error as Error).message}`)
+    process.exitCode = 1
+  },
+)

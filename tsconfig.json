{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react",
    "resolveJsonModule": true,
    "noEmitOnError": true
  },
  "include": ["runtime/**/*.ts", "runtime/**/*.tsx", "runtime/**/*.d.ts"]
}
